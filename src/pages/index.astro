		<!-- SECCIÓN PRINCIPAL (HERO) CON CARRUSEL -->
		<section class="hero">
			<!-- Contenedor de las imágenes del carrusel (puedes agregar más cambiando las rutas en la carpeta public) -->
			<div class="carousel-container">
				<div class="carousel-slide active" style="background-image: linear-gradient(90deg, rgba(15, 15, 15, 0.92) 0%, rgba(15, 15, 15, 0.70) 50%, rgba(15, 15, 15, 0.15) 100%), url('/Técnico trabajando en líneas aéreas.png');"></div>
