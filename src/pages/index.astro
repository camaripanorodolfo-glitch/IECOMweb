				<div class="carousel-slide" style="background-image: linear-gradient(90deg, rgba(15, 15, 15, 0.92) 0%, rgba(15, 15, 15, 0.70) 50%, rgba(15, 15, 15, 0.15) 100%), url('/9b3f20cb-e69b-4856-bf21-bb0d9b33aae4.png');"></div> 
				<div class="carousel-slide" style="background-image: linear-gradient(90deg, rgba(15, 15, 15, 0.92) 0%, rgba(15, 15, 15, 0.70) 50%, rgba(15, 15, 15, 0.15) 100%), url('/Conectividad brillante en el vecindario.png');"></div> 
				<div class="carousel-slide" style="background-image: linear-gradient(90deg, rgba(15, 15, 15, 0.92) 0%, rgba(15, 15, 15, 0.70) 50%, rgba(15, 15, 15, 0.15) 100%), url('/images.png');"></div>
			</div>

			<div class="hero-content">
				<span class="sub-title">28 AÑOS DE TRAYECTORIA · PÁRAMO MERIDEÑO</span>
